# Copy to .env and fill in. Never commit .env.

# --- transport -------------------------------------------------------------
# stdio = local process. http = remote MCP endpoint (protect it with OAuth).
YTM_TRANSPORT=stdio
YTM_HOST=127.0.0.1
YTM_PORT=8000

# --- auth ------------------------------------------------------------------
# none | github | google
YTM_AUTH_PROVIDER=none

# Public HTTPS URL of this server. Required once auth is on; derived
# automatically on Vercel (VERCEL_PROJECT_PRODUCTION_URL).
# The OAuth app's callback URL must be exactly ${YTM_BASE_URL}/auth/callback
# YTM_BASE_URL=https://yt.example.com

# Comma-separated identities allowed to call tools.
# GitHub -> your username (lowercase). Google -> your email address.
# YTM_ALLOWED_USERS=your-github-username

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Signs issued sessions. Generate: openssl rand -hex 32
# Set this so sessions don't depend on the OAuth client secret: leave it unset
# and the key is derived from that secret, so rotating it signs everyone out.
# JWT_SIGNING_KEY=

# Where registered OAuth clients are stored. This must outlive a deploy, or the
# connector is told to reauthorize on every ship. On Vercel, connect Upstash
# Redis and REDIS_URL is used (encrypted with JWT_SIGNING_KEY). On a host with a
# durable disk, point FASTMCP_HOME at it instead.
# REDIS_URL=
# FASTMCP_HOME=

# --- metadata --------------------------------------------------------------
# YouTube Data API v3 key. Key-authenticated, so unlike the caption endpoints
# it is NOT blocked on datacenter IPs — this is what makes cloud hosting work.
# Default quota: 10,000 units/day; a video lookup costs 1, search costs 100. Chapters are parsed
# from the description. If the key is restricted to "Websites" in Google Cloud,
# the matching Referer is sent automatically from YTM_BASE_URL.
# YOUTUBE_API_KEY=

# --- optional --------------------------------------------------------------
# YouTube often blocks caption requests from datacenter IPs. A remote deploy
# needs a rotating residential proxy for reliable cloud access;
# local stdio usually works without one. Buy Webshare "Rotating Residential"
# (not "Proxy Server" or "Static Residential"), then copy Proxy Username and
# Proxy Password from https://dashboard.webshare.io/proxy/settings. A username
# ending in `-rotate` is fine; the server normalizes it for rotating requests.
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=

# Any other provider, or a hand-built Webshare URL. Wins over the pair above.
# YTM_PROXY=http://user:pass@host:port

# Enables the Whisper fallback for videos with captions disabled.
# GROQ_API_KEY=

YTM_LOG_LEVEL=INFO
