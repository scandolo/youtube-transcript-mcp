# Copy to .env and fill in. Never commit .env.

# --- transport -------------------------------------------------------------
# stdio = local only (Stage 1). http = reachable over the tunnel (Stage 2/3).
YTM_TRANSPORT=stdio
YTM_HOST=127.0.0.1
YTM_PORT=8000

# --- auth ------------------------------------------------------------------
# none | github | google
YTM_AUTH_PROVIDER=none

# Public HTTPS URL of this server. Required once auth is on.
# The OAuth app's callback URL must be exactly ${YTM_BASE_URL}/auth/callback
# YTM_BASE_URL=https://yt.example.com

# Comma-separated identities allowed to call tools.
# GitHub -> your username (lowercase). Google -> your gmail address.
# YTM_ALLOWED_USERS=scandolo

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Keeps sessions valid across restarts. Generate: openssl rand -hex 32
# JWT_SIGNING_KEY=

# --- optional --------------------------------------------------------------
# Only needed if YouTube starts blocking this machine's IP.
# YTM_PROXY=http://user:pass@host:port

# Enables the Whisper fallback for videos with captions disabled.
# GROQ_API_KEY=

YTM_LOG_LEVEL=INFO
